# WorldSeed uses LiteLLM — any supported provider works.
# Copy this file to .env and set your API key.
#
# Only ONE provider key is needed. Uncomment the one you use:

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AI...

# See all providers: https://docs.litellm.ai/docs/providers

# --- xcity tokenhub (first-class provider) -----------------------------------
# Models appear in the lobby as `xcity/<id>` and route through tokenhub
# without touching OPENAI_API_KEY, so stock OpenAI can stay configured alongside.
# XCT_TOKENHUB_API_KEY=
# XCT_TOKENHUB_API_BASE=https://tokenhub.xcity.one/v1   # default; override only for testing

# --- Generic OpenAI-compatible gateway (escape hatch) ------------------------
# For any *other* OpenAI-compatible endpoint. Models appear as `openai/<id>`.
# When set, this *replaces* stock OpenAI discovery in the lobby.
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://your-proxy.example.com/v1

# Some gateways front thinking-mode models that reject a forced tool_choice;
# set this to use Instructor JSON mode instead of the default TOOLS mode:
# WORLDSEED_DM_INSTRUCTOR_MODE=json

# Optional: default DM model (shown in lobby, used by CLI)
# Format: model name as listed in the lobby dropdown (e.g. xcity/glm-5.1)
# WORLDSEED_DM_MODEL=

# Optional: FLUX image generation (for scene-assets skill)
# BFL_API_KEY=bfl_...
